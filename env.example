# Optional direct HTTPS mode for regular MI2/CXR clients and the factory.
# Keep the regular endpoint slots above; pair a URL with its explicit key below.
# Supported hosts: *.inference.ml.azure.com and *.services.ai.azure.com.
# Use a full inference URL (no query, fragment, userinfo, or documentation path).
# Regular clients still send their original input_data scoring schema: the
# endpoint must accept that schema. Host recognition is not API compatibility.
# Constructors accept endpoint_name=url and api_key=key directly, or read their
# class-specific settings. URL setup does not look up AML management credentials.
MI2_MODEL_API_KEY = ""
CXRREPORTGEN_MODEL_API_KEY = ""

# Premium uses separate slots, independent of host. Deployment overrides are
# optional; leave blank to use MedImageInsight-Premium or CxrReportGen-Premium.
# Supply your deployment name if different. Full URLs are used unchanged.
# A Foundry account root
# https://{account}.services.ai.azure.com is completed only for premium:
# MI2: /providers/microsoft/v2/embed; CXR: /providers/microsoft/v1/inference.
# AML IDs/names look up the target and, if no key is set, retrieve the AML key.
MI2_PREMIUM_ENDPOINT = ""
MI2_PREMIUM_API_KEY = ""
MI2_PREMIUM_DEPLOYMENT_NAME = ""
CXRREPORTGEN_PREMIUM_ENDPOINT = ""
CXRREPORTGEN_PREMIUM_API_KEY = ""
CXRREPORTGEN_PREMIUM_DEPLOYMENT_NAME = ""
# Factory variant="opensource" or "premium" selects that class and forwards kwargs.
# Explicit endpoint/key/deployment kwargs can satisfy missing settings.
# With no variant, configured endpoint settings select the class:
# premium wins if both are set; the sole configured slot wins otherwise.
# Neither setting is an error, even with endpoint kwargs. Constructors validate
# selected configuration; errors propagate with no fallback or probing.
# Factory model selects "mi2"/"cxrreportgen"; deployment_name overrides the
# selected premium deployment setting. Never put keys in endpoint URLs.

# Root directory for data storage (use absolute path)
DATA_ROOT = /home/azureuser/data/healthcare-ai/

# Azure OpenAI / GPT Configuration (Optional)
# You can specify either:
# 1. Full inference URI (includes deployment and API version):
#    AZURE_OPENAI_ENDPOINT = "https://{your-service}.cognitiveservices.azure.com/openai/deployments/{deployment-name}/chat/completions?api-version={api_version}"
# 2. Base endpoint with separate model configuration:
#    AZURE_OPENAI_ENDPOINT = "https://{your-service}.cognitiveservices.azure.com/"
#    AZURE_OPENAI_DEPLOYMENT_NAME = "gpt-4o"
# Required: API key for authentication
AZURE_OPENAI_ENDPOINT = ""